          {
            "name": "search",
            "in": "query",
            "description": "Поиск по Имени, Артикулу или Бренду",
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "description": "A page number within the paginated result set.",
            "required": false,
            "type": "integer"
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Кол-во элементов на странице (по умолч: 5, макс: 100)",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "",
