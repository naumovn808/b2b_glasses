
FROM node:20-alpine AS builder
WORKDIR /app/frontend
COPY package.json package-lock.json ./
RUN npm install
COPY . .
RUN npm run build 

FROM node:20-alpine
WORKDIR /app/frontend
COPY --from=builder /app/frontend/dist ./dist
COPY package.json .
RUN npm install
CMD ["npm", "run", "preview", "--", "--host", "--port", "3000"]
